rules_version = '2';

// Access model: .omo/plans/v1-phase0-3.md "Data model (Firestore)". Default deny.
// Security review: .omo/reviews/security-r1.md (finding ids S-xx are referenced inline).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers: auth and paths ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function myMemberPath(gid) { return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid); }
    function memberPath(gid, uid) { return /databases/$(database)/documents/groups/$(gid)/members/$(uid); }
    function crewPath(gid, cid) { return /databases/$(database)/documents/groups/$(gid)/crews/$(cid); }
    function tripPath(gid, cid, tid) { return /databases/$(database)/documents/groups/$(gid)/crews/$(cid)/trips/$(tid); }

    function isActiveMember(gid) {
      return signedIn() && exists(myMemberPath(gid)) && get(myMemberPath(gid)).data.status == 'active';
    }
    function isAdmin(gid) {
      return isActiveMember(gid) && get(myMemberPath(gid)).data.role in ['owner', 'admin'];
    }
    // Same checks against the state after the current batch/transaction (group creation, code rotation).
    function isAdminAfter(gid) {
      let m = getAfter(myMemberPath(gid));
      return signedIn() && m != null && m.data.status == 'active' && m.data.role in ['owner', 'admin'];
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function emailDomainAllowed(group) {
      return group.data.allowedEmailDomains.size() == 0
        || (request.auth.token.email_verified == true
            && request.auth.token.email.lower().split('@')[1] in group.data.allowedEmailDomains);
    }

    function isCrewMember(gid, cid) {
      return request.auth.uid in get(crewPath(gid, cid)).data.memberIds;
    }

    // ---------- helpers: value shapes (S-09) ----------
    function str(v, max) { return v is string && v.size() <= max; }
    function name(v) { return v is string && v.size() >= 1 && v.size() <= 80; }
    function id(v) { return v is string && v.size() >= 1 && v.size() <= 128; }
    function optId(v) { return v == null || id(v); }
    function optStr(v, max) { return v == null || str(v, max); }
    function list(v, max) { return v is list && v.size() <= max; }
    function intIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function isoDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function clock(v) { return v == null || v == '' || (v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    function latLng(v) {
      return v is map && v.lat is number && v.lng is number
        && v.lat >= -90 && v.lat <= 90 && v.lng >= -180 && v.lng <= 180;
    }
    // Alphabet of INVITE_ALPHABET in src/data/groups.ts (no 0/O, 1/I/L), length 8 (S-10).
    function inviteCode(v) { return v is string && v.matches('^[A-HJ-KM-NP-Z2-9]{8}$'); }

    function validGroup(d) {
      return d.keys().hasOnly(['name', 'type', 'country', 'locale', 'ownerId', 'inviteCode', 'allowedEmailDomains',
                               'destination', 'policy', 'createdAt'])
        && name(d.name)
        && d.type in ['company', 'university', 'club', 'school', 'church', 'other']
        && str(d.country, 3)
        && d.locale in ['ko', 'en']
        && id(d.ownerId)
        && inviteCode(d.inviteCode)
        && list(d.allowedEmailDomains, 20)
        && (d.destination == null || (latLng(d.destination) && str(d.destination.label, 200)))
        && d.policy is map
        && str(d.createdAt, 40);
    }

    function validMember(d) {
      return d.keys().hasOnly(['uid', 'displayName', 'role', 'status', 'canDrive', 'seats', 'plateLastDigit',
                               'areaLabel', 'area', 'schedule', 'joinedAt', 'inviteCode'])
        && id(d.uid)
        && str(d.displayName, 80)
        && d.role in ['owner', 'admin', 'member']
        && d.status in ['active', 'left', 'removed']
        && d.canDrive is bool
        && intIn(d.seats, 0, 8)
        && (d.plateLastDigit == null || intIn(d.plateLastDigit, 0, 9))
        && str(d.areaLabel, 200)
        && (d.area == null || latLng(d.area))
        && d.schedule is map && d.schedule.size() <= 7
        && str(d.joinedAt, 40)
        && str(d.inviteCode, 16);
    }

    function validCrew(d) {
      return d.keys().hasOnly(['name', 'memberIds', 'captainId', 'backupDriverIds', 'acceptedIds', 'status', 'days',
                               'outTime', 'backTime', 'pickupNote', 'waitLimitMin', 'scores', 'lastDroveOn',
                               'createdBy', 'createdAt', 'ledgerTripId'])
        && name(d.name)
        && d.memberIds is list && d.memberIds.size() >= 2 && d.memberIds.size() <= 6
        && d.captainId in d.memberIds
        && list(d.backupDriverIds, 6)
        && list(d.acceptedIds, 6)
        && d.status in ['proposed', 'active', 'paused']
        && list(d.days, 7)
        && clock(d.outTime) && clock(d.backTime)
        && str(d.pickupNote, 500)
        && d.waitLimitMin is number && d.waitLimitMin >= 0 && d.waitLimitMin <= 120
        && d.scores is map && d.scores.size() <= 20
        && d.lastDroveOn is map && d.lastDroveOn.size() <= 20
        && id(d.createdBy)
        && str(d.createdAt, 40)
        && (!('ledgerTripId' in d) || id(d.ledgerTripId));
    }

    // S-15: costs are non-negative, bounded and carry a three-letter currency code.
    function validCost(c) {
      return c == null || (c is map && c.keys().hasOnly(['totalAmount', 'currency'])
        && c.totalAmount is number && c.totalAmount >= 0 && c.totalAmount < 10000000
        && c.currency is string && c.currency.matches('^[A-Z]{3}$'));
    }

    function validTrip(d) {
      return d.keys().hasOnly(['date', 'leg', 'driverId', 'riderIds', 'absentIds', 'status', 'applied',
                               'completedBy', 'completedAt', 'cost'])
        && isoDate(d.date)
        && d.leg in ['out', 'back']
        && optId(d.driverId)
        // A driven trip seats at most five riders (k <= 6 in the ledger); an open trip may hold the whole crew.
        && list(d.riderIds, d.driverId == null ? 6 : 5)
        && list(d.absentIds, 6)
        && d.status in ['planned', 'needs_driver', 'done', 'cancelled']
        && d.applied is bool
        && optId(d.completedBy)
        && optStr(d.completedAt, 40)
        && validCost(d.cost);
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'date', 'time', 'place', 'createdBy', 'createdAt'])
        && name(d.title)
        && str(d.date, 10)
        && str(d.time, 10)
        && str(d.place, 200)
        && id(d.createdBy)
        && str(d.createdAt, 40);
    }

    function validCar(d) {
      return d.keys().hasOnly(['driverId', 'driverName', 'seats', 'riderIds', 'note'])
        && id(d.driverId)
        && str(d.driverName, 80)
        && intIn(d.seats, 0, 8)
        && d.riderIds is list && d.riderIds.size() <= d.seats
        && str(d.note, 200);
    }

    // ---------- helpers: crew ledger (S-02 (e), AR-1 Option A) ----------
    function scoreBefore(uid) { return resource.data.scores.get(uid, 0); }
    function scoreAfter(uid) { return request.resource.data.scores.get(uid, 0); }
    function riderPaid(t, i, share) {
      return t.riderIds.size() <= i || scoreAfter(t.riderIds[i]) == scoreBefore(t.riderIds[i]) - share;
    }

    // scores / lastDroveOn move only together with the trip named by ledgerTripId flipping applied
    // false -> true in the same batch, by exactly the Fagin-Williams amounts (U = 60, k = riders + 1).
    function ledgerMoveBackedByTrip(gid, cid) {
      let tid = request.resource.data.ledgerTripId;
      let before = get(tripPath(gid, cid, tid)).data;
      let t = getAfter(tripPath(gid, cid, tid)).data;
      let k = t.riderIds.size() + 1;
      let share = 60 / k;
      let crew = request.resource.data;
      return before.applied != true && t.applied == true
        && t.driverId is string && t.driverId in crew.memberIds
        && !(t.driverId in t.riderIds)
        && t.riderIds.size() <= 5 && t.riderIds.toSet().size() == t.riderIds.size()
        && crew.memberIds.toSet().hasAll(t.riderIds)
        && crew.scores.diff(resource.data.scores).affectedKeys().hasOnly(t.riderIds.concat([t.driverId]))
        && scoreAfter(t.driverId) == scoreBefore(t.driverId) + share * (k - 1)
        && riderPaid(t, 0, share) && riderPaid(t, 1, share) && riderPaid(t, 2, share)
        && riderPaid(t, 3, share) && riderPaid(t, 4, share)
        && crew.lastDroveOn.diff(resource.data.lastDroveOn).affectedKeys().hasOnly([t.driverId])
        && crew.lastDroveOn[t.driverId] == laterDate(resource.data.lastDroveOn.get(t.driverId, ''), t.date);
    }
    function laterDate(a, b) { return a > b ? a : b; }

    // Each score of a new crew is 0 (at most 6 members, see validCrew).
    function scoreZero(d, i) { return d.memberIds.size() <= i || d.scores.get(d.memberIds[i], 0) == 0; }
    function startsWithEmptyLedger(d) {
      return d.scores.keys().hasOnly(d.memberIds)
        && scoreZero(d, 0) && scoreZero(d, 1) && scoreZero(d, 2) && scoreZero(d, 3) && scoreZero(d, 4) && scoreZero(d, 5)
        && d.lastDroveOn.size() == 0
        && !('ledgerTripId' in d);
    }

    // ---------- helpers: crew updates (S-02 (a)-(d)) ----------
    // Accepting adds only the caller; nothing is removed. The crew turns active once everyone accepted.
    function isOwnAcceptance() {
      let before = resource.data.acceptedIds.toSet();
      let after = request.resource.data.acceptedIds.toSet();
      return onlyChanged(['acceptedIds', 'status'])
        && after.difference(before).difference([me()].toSet()).size() == 0
        && before.difference(after).size() == 0
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'proposed' && request.resource.data.status == 'active'
                && after.hasAll(request.resource.data.memberIds)));
    }
    function isCrewSettingsEdit() {
      let s0 = resource.data.status;
      let s1 = request.resource.data.status;
      return onlyChanged(['name', 'days', 'outTime', 'backTime', 'pickupNote', 'waitLimitMin', 'backupDriverIds',
                          'status', 'captainId'])
        && (s0 == s1 || (s0 in ['active', 'paused'] && s1 in ['active', 'paused']))
        && request.resource.data.memberIds.toSet().hasAll(request.resource.data.backupDriverIds);
    }
    // A membership change restarts acceptance: only the captain has accepted and the crew is proposed again.
    function isMembershipChange() {
      return onlyChanged(['memberIds', 'acceptedIds', 'status'])
        && request.resource.data.acceptedIds == [request.resource.data.captainId]
        && request.resource.data.status == 'proposed';
    }

    // ---------- helpers: trip driver (R-02) ----------
    // The stored driver can no longer drive this trip: absent, out of the crew, inactive or not driving.
    function driverUnavailable(gid, cid, uid) {
      return uid in request.resource.data.absentIds
        || !(uid in get(crewPath(gid, cid)).data.memberIds)
        || !exists(memberPath(gid, uid))
        || get(memberPath(gid, uid)).data.status != 'active'
        || get(memberPath(gid, uid)).data.canDrive != true;
    }
    // Who may change a trip's driver: admins; a volunteer taking an open seat for themselves; the driver
    // giving up; the planner replacing an unavailable driver or reopening a cancelled trip with a crew member.
    function driverChangeOk(gid, cid) {
      let d0 = resource.data.driverId;
      let d1 = request.resource.data.driverId;
      return d0 == d1
        || isAdmin(gid)
        || (d0 == null && resource.data.status == 'needs_driver' && d1 == me())
        || (d0 == me() && d1 == null && request.resource.data.status == 'needs_driver')
        || ((d1 == null || d1 in get(crewPath(gid, cid)).data.memberIds)
            && (resource.data.status == 'cancelled' || (d0 != null && driverUnavailable(gid, cid, d0))));
    }

    // ---------- helpers: members (S-06, S-07) ----------
    function adminStatusChangeOk() {
      let s0 = resource.data.status;
      let s1 = request.resource.data.status;
      return s0 == s1 || (s1 == 'removed' && s0 in ['active', 'left']) || (s0 == 'removed' && s1 == 'active');
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
    }

    // ---------- invite codes ----------
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && inviteCode(code)
        && request.resource.data.keys().hasOnly(['id', 'groupId', 'groupName', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == me()
        && isAdminAfter(request.resource.data.groupId)
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code;
      allow delete: if isAdmin(resource.data.groupId);
    }

    // Collection-group query for "my groups": a user may read their own membership docs.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    // ---------- groups ----------
    match /groups/{gid} {
      allow read: if isActiveMember(gid);
      allow create: if signedIn() && request.resource.data.ownerId == me() && validGroup(request.resource.data);
      allow update: if isAdmin(gid) && unchanged(['ownerId', 'createdAt']) && validGroup(request.resource.data);

      match /members/{memberId} {
        // A former member can still read their own doc to re-join.
        allow read: if isActiveMember(gid) || (signedIn() && memberId == me());

        allow create: if signedIn()
          && memberId == me()
          && validMember(request.resource.data)
          && request.resource.data.uid == me()
          && request.resource.data.status == 'active'
          && (
            (request.resource.data.role == 'member'
              && request.resource.data.inviteCode == get(groupPath(gid)).data.inviteCode
              && emailDomainAllowed(get(groupPath(gid))))
            || (request.resource.data.role == 'owner'
              && getAfter(groupPath(gid)).data.ownerId == me())
          );

        allow update: if signedIn() && unchanged(['uid', 'joinedAt']) && validMember(request.resource.data) && (
          // Self edits while active. A member may leave (the owner may not: S-06), never restore a removal.
          (memberId == me()
            && resource.data.status == 'active'
            && unchanged(['role', 'inviteCode'])
            && (request.resource.data.status == 'active'
                || (request.resource.data.status == 'left' && resource.data.role != 'owner')))
          // Re-join after leaving: needs the group's current invite code and comes back as a plain member.
          || (memberId == me()
            && resource.data.status == 'left'
            && request.resource.data.status == 'active'
            && request.resource.data.role == 'member'
            && request.resource.data.inviteCode == get(groupPath(gid)).data.inviteCode
            && emailDomainAllowed(get(groupPath(gid))))
          // Admins change only role (member <-> admin) and removal of non-owners, never profile fields (S-07).
          || (isAdmin(gid)
              && onlyChanged(['role', 'status'])
              && resource.data.role != 'owner'
              && request.resource.data.role in ['admin', 'member']
              && adminStatusChangeOk())
        );
      }

      match /crews/{cid} {
        allow read: if isActiveMember(gid);
        allow create: if isActiveMember(gid)
          && validCrew(request.resource.data)
          && request.resource.data.createdBy == me()
          && me() in request.resource.data.memberIds
          && request.resource.data.acceptedIds == [me()]
          && request.resource.data.status == 'proposed'
          && startsWithEmptyLedger(request.resource.data);

        allow update: if isActiveMember(gid) && validCrew(request.resource.data) && (
          // (a) accept for yourself
          (me() in resource.data.memberIds && isOwnAcceptance())
          // (b)+(d) settings and captain handover: captain or admin; the captain stays a crew member (validCrew)
          || ((me() == resource.data.captainId || isAdmin(gid)) && isCrewSettingsEdit())
          // (c) membership: captain or admin, 2..6 (validCrew), acceptance restarts
          || ((me() == resource.data.captainId || isAdmin(gid)) && isMembershipChange())
          // (e) ledger: only as part of settling a trip of this crew
          || ((me() in resource.data.memberIds || isAdmin(gid))
              && onlyChanged(['scores', 'lastDroveOn', 'ledgerTripId'])
              && ledgerMoveBackedByTrip(gid, cid))
        );

        match /trips/{tid} {
          allow read: if isActiveMember(gid);
          // S-03: a trip is born unsettled, under the id "<date>_<leg>".
          allow create: if isActiveMember(gid) && (isCrewMember(gid, cid) || isAdmin(gid))
            && validTrip(request.resource.data)
            && tid == request.resource.data.date + '_' + request.resource.data.leg
            && request.resource.data.status in ['planned', 'needs_driver']
            && request.resource.data.applied == false
            && request.resource.data.completedBy == null
            && request.resource.data.completedAt == null;
          allow update: if isActiveMember(gid)
            && (isCrewMember(gid, cid) || isAdmin(gid))
            && validTrip(request.resource.data)
            && (
              // Once applied to the ledger a trip is frozen (no undo, no rewriting who drove); only cost may be filled in.
              (resource.data.applied == true && onlyChanged(['cost']))
              // Planning edits: absences, driver, cancellation. Never done without the ledger.
              || (resource.data.applied != true
                  && request.resource.data.applied == false
                  && request.resource.data.status in ['planned', 'needs_driver', 'cancelled']
                  && unchanged(['date', 'leg', 'completedBy', 'completedAt'])
                  && driverChangeOk(gid, cid))
              // Settlement: by the caller, paired with the crew ledger move in the same batch.
              || (resource.data.applied != true
                  && request.resource.data.applied == true
                  && request.resource.data.status == 'done'
                  && request.resource.data.completedBy == me()
                  && request.resource.data.completedAt is string
                  && onlyChanged(['status', 'applied', 'completedBy', 'completedAt', 'driverId', 'riderIds'])
                  && getAfter(crewPath(gid, cid)).data.get('ledgerTripId', null) == tid)
            );
        }
      }

      match /events/{eid} {
        allow read: if isActiveMember(gid);
        allow create: if isActiveMember(gid) && request.resource.data.createdBy == me() && validEvent(request.resource.data);
        allow update: if isActiveMember(gid)
          && (resource.data.createdBy == me() || isAdmin(gid))
          && unchanged(['createdBy', 'createdAt'])
          && validEvent(request.resource.data);
        allow delete: if isActiveMember(gid) && (resource.data.createdBy == me() || isAdmin(gid));

        match /cars/{carId} {
          allow read: if isActiveMember(gid);
          // A car starts empty; riders add themselves (S-08).
          allow create: if isActiveMember(gid)
            && carId == me()
            && request.resource.data.driverId == me()
            && validCar(request.resource.data)
            && request.resource.data.riderIds.size() == 0;
          allow update: if isActiveMember(gid) && validCar(request.resource.data) && (
            // The driver edits the car and may drop riders, never enroll anyone (S-08).
            (carId == me()
              && request.resource.data.driverId == me()
              && resource.data.riderIds.toSet().hasAll(request.resource.data.riderIds))
            // Riders join/leave by adding or removing only their own uid.
            || (onlyChanged(['riderIds']) && riderChangeIsMine())
          );
          allow delete: if isActiveMember(gid) && carId == me();
        }
      }
    }

    function riderChangeIsMine() {
      let before = resource.data.riderIds.toSet();
      let after = request.resource.data.riderIds.toSet();
      let added = after.difference(before);
      let removed = before.difference(after);
      return (added == [request.auth.uid].toSet() && removed.size() == 0)
        || (removed == [request.auth.uid].toSet() && added.size() == 0);
    }
  }
}
