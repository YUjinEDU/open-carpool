# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Use local Firebase emulators (npm run emulators). Project id must start with "demo-" for offline use.
VITE_USE_FIREBASE_EMULATOR="false"

# Maps: Naver for Korea, Google elsewhere
VITE_NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
VITE_GOOGLE_MAPS_API_KEY=""

# Optional sign-in providers
VITE_KAKAO_OIDC_ENABLED="false"
VITE_KAKAO_JS_KEY=""

# Optional Firebase App Check (reCAPTCHA Enterprise site key). Empty = App Check off. See docs/SELF_HOSTING.md
VITE_APPCHECK_SITE_KEY=""

# Serverless API rate limit per user (in-memory, best effort): requests per window, window in seconds
NAVER_RATE_LIMIT="60"
NAVER_RATE_WINDOW_SEC="300"

# Serverless API: comma-separated exact origins allowed to call /api/naver/*
ALLOWED_ORIGINS=""
