# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Use local Firebase emulators (npm run emulators). Project id must start with "demo-" for offline use.
VITE_USE_FIREBASE_EMULATOR="false"

# Maps: Naver for Korea, Google elsewhere
VITE_NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
VITE_GOOGLE_MAPS_API_KEY=""

# Optional sign-in providers
VITE_KAKAO_OIDC_ENABLED="false"
VITE_KAKAO_JS_KEY=""

# Serverless API: comma-separated exact origins allowed to call /api/naver/*
ALLOWED_ORIGINS=""
